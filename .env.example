# ==============================================================================
# 🛰️ TeleHarvester Pro — Configuration Template
# ==============================================================================
# Rename this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or *.session files to GitHub!
# ==============================================================================

# 1. Telegram API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890

# 2. Session Configuration
SESSION_NAME=tele_harvester_session

# 3. Destination Channels / Groups (IDs or @usernames)
# Primary channel where all drops and alerts will be broadcasted
PRIMARY_ALERT_CHANNEL_ID=-1001234567890

# Optional Specialized Category Routing
# Leave blank or 0 to send all alerts solely to PRIMARY_ALERT_CHANNEL_ID
CANVA_ALERT_CHANNEL_ID=
CANVA_TOPIC_ID=

VPN_ALERT_CHANNEL_ID=
AI_ALERT_CHANNEL_ID=

# 4. Networking & Resilience
LOCK_PORT=58921
MAX_RECONNECT_BACKOFF_SECONDS=60
FLOOD_SLEEP_THRESHOLD_SECONDS=60

# 5. Local Storage & Desktop Notifications
ENABLE_DESKTOP_NOTIFICATIONS=true
ENABLE_LOCAL_JSON_LOGGING=true
ENABLE_LOCAL_MARKDOWN_LOGGING=true

# 6. Logging
LOG_LEVEL=INFO
